# .env.example
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# NEVER put real values in this file.

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/upwork_bidder

# ── Redis (BullMQ queue) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI Model Provider ─────────────────────────────────────────
# Google Gemini (default). See packages/ai/src/provider.ts to change model.
AI_API_KEY=your-google-ai-api-key-here
AI_MODEL_NAME=gemini-1.5-pro

# ── App Session ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=your-32-character-minimum-random-secret-here

# ── Upwork MCP ────────────────────────────────────────────────
UPWORK_MCP_URL=https://mcp.upwork.com/mcp

# ── OAuth Token Encryption ────────────────────────────────────
# Used to encrypt stored Upwork OAuth tokens at rest.
# Generate with: openssl rand -hex 32
# ROTATE THIS if you suspect it has been exposed. See docs/RUNBOOK.md.
OAUTH_TOKEN_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# ── App URL ───────────────────────────────────────────────────
# Full URL including protocol. Used for OAuth redirect URIs.
APP_URL=http://localhost:3000

# ── Environment ───────────────────────────────────────────────
NODE_ENV=development

# ── Feature Flags (override DB settings for local dev) ───────
# Leave empty to use DB settings table values.
# ENABLE_AI_SCORING=true
# ENABLE_DRAFT_ENGINE=true
# ENABLE_ANALYTICS=true
