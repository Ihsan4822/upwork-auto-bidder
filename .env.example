# .env.example
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# NEVER put real values in this file.

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/upwork_bidder

# ── Redis (BullMQ queue) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI Model Provider ─────────────────────────────────────────
# Google Gemini (default). See packages/ai/src/provider.ts to change model.
AI_API_KEY=your-google-ai-api-key-here
AI_MODEL_NAME=gemini-1.5-pro

# ── App Session ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=your-32-character-minimum-random-secret-here

# ── Upwork OAuth 2.1 & MCP ────────────────────────────────────
# Register an app in Upwork Developer Center (https://www.upwork.com/services/api/apply)
# Scopes requested must strictly be: jobs:read profile:read
UPWORK_CLIENT_ID=your-upwork-oauth-client-id
UPWORK_CLIENT_SECRET=your-upwork-oauth-client-secret
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_AUTH_URL=https://www.upwork.com/ab/account-security/oauth2/authorize
UPWORK_TOKEN_URL=https://www.upwork.com/api/v3/oauth2/token

# ── OAuth Token Encryption ────────────────────────────────────
# Used to encrypt stored Upwork OAuth tokens at rest with AES-256-GCM.
# Generate with: openssl rand -hex 32 (Must be 64-char hex string)
# ROTATE THIS if you suspect it has been exposed. See docs/RUNBOOK.md.
OAUTH_TOKEN_ENCRYPTION_KEY=your-64-character-hex-encryption-key-here

# ── App URL ───────────────────────────────────────────────────
# Full URL including protocol. Used for OAuth redirect URIs.
APP_URL=http://localhost:3000

# ── Environment ───────────────────────────────────────────────
NODE_ENV=development

# ── Feature Flags (override DB settings for local dev) ───────
# Defaults to false per section 11.
ENABLE_AI_SCORING=false
ENABLE_DRAFT_ENGINE=false
ENABLE_ANALYTICS=false
